node_modules/
bin/
*.log
.DS_Store

# Build and test artefacts
test-results/
playwright-report/
.playwright-mcp/

# Credentials and machine-local state. server/.env.local carries the Blob
# read-write token; it must never enter history.
.env
.env.*
server/.vercel/
.vercel/

# Creator Hub's Inspector artefacts. Its defaults say "Test Scene" and would
# fight scene.json if they came back.
.editor/
assets/scene/main.composite

# Generated by the @dcl/sdk-commands postinstall hook, which runs
# `get-context-files` in the scene root. It is SDK reference material for AI
# tooling, not source, and it appears only where install scripts are allowed to
# run - which is why CI saw it and this machine did not.
dclcontext/
