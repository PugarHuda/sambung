{
  "name": "sambung",
  "version": "1.0.0",
  "description": "Sambung \u2014 mobile-first Simon-says played with Decentraland avatar emotes.",
  "license": "MIT",
  "scripts": {
    "start": "sdk-commands start",
    "build": "sdk-commands build",
    "deploy": "sdk-commands deploy --target-content https://worlds-content-server.decentraland.org",
    "test": "node --test src/*.test.ts",
    "test:e2e": "playwright test --project=abuse",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dupes": "jscpd src server e2e --min-lines 5 --min-tokens 50 --reporters console --format typescript,tsx",
    "budget": "node scripts/scene-budget.mjs",
    "sound": "node scripts/make-sound.mjs",
    "verify": "playwright test --project=deployed",
    "serve": "node scripts/serve-endpoint.mjs",
    "notes": "node scripts/notes.mjs"
  },
  "devDependencies": {
    "@dcl/js-runtime": "7.26.0",
    "@dcl/sdk": "7.26.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.3.0",
    "@upstash/redis": "^1.38.3",
    "eslint": "^10.9.1",
    "jscpd": "^5.0.16",
    "prettier": "^3.9.6",
    "typescript-eslint": "^8.68.0"
  }
}
